# Minimal OPRF process image. One dependency: sodium-native.
# Shares the base image with the main server for sodium-native binary compat.

FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Minimal install: only sodium-native runtime dep. All workspace package.json
# files are needed for pnpm resolution, but --filter limits actual installation.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/server/package.json ./packages/server/
COPY packages/shared/package.json ./packages/shared/
COPY packages/client/package.json ./packages/client/
COPY packages/crypto/package.json ./packages/crypto/

ENV COREPACK_HOME=/app/.corepack
RUN corepack enable pnpm \
    && pnpm install --frozen-lockfile --ignore-scripts --filter @care-y/server --filter @care-y/crypto \
    && pnpm rebuild sodium-native

# Copy the files the OPRF process needs. Includes @care-y/crypto source
# because blindEvaluate uses requireSodium() for ristretto255 (sodium-native
# does not expose ristretto255 functions).
COPY packages/server/src/crypto/oprf-server.ts ./packages/server/src/crypto/
COPY packages/server/src/crypto/oprf-process.ts ./packages/server/src/crypto/
COPY packages/server/src/crypto/ipc-protocol.ts ./packages/server/src/crypto/
COPY packages/server/src/errors.ts ./packages/server/src/
COPY packages/crypto ./packages/crypto
COPY packages/shared ./packages/shared
COPY packages/server/tsconfig.json ./packages/server/
COPY tsconfig.json tsconfig.base.json ./

# Non-root user for credential drop target.
# Primary group is oprf-ipc (GID 3001), the shared group for OPRF socket access.
# Sockets created by this process inherit GID 3001, so the app container's user
# (UID 1001, also in oprf-ipc) can connect via group-write permission (0770).
RUN groupadd --system --gid 3001 oprf-ipc \
    && useradd --system --gid oprf-ipc --uid 2001 oprf-user

USER 2001
CMD ["pnpm", "--filter", "@care-y/server", "exec", \
     "tsx", "src/crypto/oprf-process.ts"]
