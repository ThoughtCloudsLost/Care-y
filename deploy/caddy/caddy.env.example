# Caddy credentials and ACME settings. The live copy is /etc/care-y/caddy.env
# (0600 root:root), loaded by env_file on the caddy service only; the app
# containers never see it. Placeholders only; never commit real values.

# Cloudflare API token for the DNS-01 challenge. One token with
# Zone.Zone:Read and Zone.DNS:Edit, zone resources limited to the app
# domain's zone (SEC-256).
CF_API_TOKEN=replace-me

# Contact address for the ACME account.
CADDY_ACME_EMAIL=admin@example.org

# Let's Encrypt staging directory until routing is proven. Afterwards switch
# to the production directory, https://acme-v02.api.letsencrypt.org/directory
# (repeated attempts against production can hit rate limits that block
# issuance for up to a week, SEC-255).
CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
