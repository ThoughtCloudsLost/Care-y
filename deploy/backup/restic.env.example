# Backup client settings for the primary host. The live copy is
# /etc/care-y/restic.env (root:root 0600), created from this file by
# install-restic.sh. No container mounts it, and none of its values belong in
# prod.env or secrets.env; the application does not use them.
#
# The backup scripts read this file with bash. Keep every value in single
# quotes, and do not put a single quote inside a value.
# Fill in each empty value before the first backup.

# Repository on the backup host, in the form
#   rest:https://<backup host IP>:8000/<rest-server user>
# The path is the rest-server user name (rest-server runs with
# --private-repos). The URL carries no credentials.
RESTIC_REPOSITORY=''

# File holding the repository password (root:root 0600). This is the backup
# key held in escrow.
RESTIC_PASSWORD_FILE='/etc/care-y/restic.password'

# The backup host's self-signed certificate, copied by install-restic.sh.
# restic verifies the server against it (--cacert).
RESTIC_CACERT='/etc/care-y/backup-ca.pem'

# rest-server HTTP credential for this host, the user and password in the
# backup host's htpasswd file. restic reads both variables itself.
RESTIC_REST_USERNAME=''
RESTIC_REST_PASSWORD=''

# UptimeRobot heartbeat URL, pinged after each verified backup. Leave empty
# to skip the ping. Anyone holding the URL can send the heartbeat, so treat
# it as a credential.
BACKUP_HEARTBEAT_URL=''
