# Non-secret settings for docker-compose.prod.yml. The live copy is
# /opt/care-y/prod.env (root-owned, next to the compose file, untracked).
# Every compose command on the host passes it:
#
#   docker compose --env-file prod.env -f docker-compose.prod.yml <command>
#
# Non-secret by contract. The deploy script sources this file into its shell
# and compose substitutes the values into the compose file. Secrets live in
# files under /etc/care-y, never here.
#
# One KEY=value per line: no quotes, no spaces around "=".
# Example values only. Replace each one before the first deploy.

# Owner of the image repositories on ghcr.io (a user or organization).
# Image references must be lowercase, so write the owner in lowercase.
GHCR_OWNER=example-owner

# Image tag every service runs: the full 40-character commit SHA of the
# release. The deploy script rewrites this line on every deploy, so the line
# must stay present. Never "latest".
IMAGE_TAG=0000000000000000000000000000000000000000

# Apex host. Caddy serves the static page, the canary and the webhook
# endpoints here, and nothing else.
CAREY_APEX_HOST=example.org

# Domain the org subdomains hang off (<slug>.<domain>), without scheme or
# path. Caddy's wildcard site and the setup links the operator CLIs print
# both use it. Normally the same value as CAREY_APEX_HOST.
CAREY_APP_DOMAIN=example.org

# Public base URL that telephony providers call for webhooks. Webhook routes
# carry the org id in the path, so the apex serves them for every org.
WEBHOOK_BASE_URL=https://example.org

# Proof-of-work difficulty for the public intake form, in leading zero bits.
# 0 disables it. The compose file falls back to 16 when this line is absent.
INTAKE_POW_DIFFICULTY=16

# Sender address for platform mail (operator alerts, invitations). The SMTP
# host, port, user and password are secrets and live in /etc/care-y, not here;
# this is only the visible From address, and it must be the address those
# credentials are issued for.
SMTP_FROM=noreply@example.org
