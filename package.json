{
  "name": "@care-y/root",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "typecheck": "tsc --build && pnpm --filter @care-y/client exec svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint packages/",
    "format": "prettier --check --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "format:fix": "prettier --write --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "test": "vitest run",
    "test:server:db": "docker compose -f docker-compose.yml -f docker-compose.test.yml exec app pnpm vitest run --project server",
    "test:watch": "vitest",
    "test:coverage": "docker compose -f docker-compose.yml -f docker-compose.test.yml exec app pnpm vitest run --coverage",
    "clean": "tsc --build --clean",
    "migrate": "tsx --env-file=.env packages/server/src/db/migrate.ts --platform",
    "migrate:down": "tsx --env-file=.env packages/server/src/db/migrate.ts down --platform",
    "migrate:tenant": "tsx --env-file=.env packages/server/src/db/migrate.ts --schema=",
    "migrate:tenant:down": "tsx --env-file=.env packages/server/src/db/migrate.ts down --schema=",
    "migrate:all": "tsx --env-file=.env packages/server/src/db/migrate.ts --all-schemas",
    "migrate:create-schema": "tsx --env-file=.env packages/server/src/db/schema-create.ts",
    "seed": "tsx --env-file=.env packages/server/src/scripts/seed.ts",
    "postinstall": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sodium-native"
    ],
    "overrides": {
      "@types/node": "25.4.0",
      "devalue": ">=5.6.4",
      "serialize-javascript": ">=7.0.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/node": "25.4.0",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@playwright/test": "1.58.2",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "10.0.2",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-svelte": "3.15.0",
    "fast-check": "4.6.0",
    "lefthook": "2.1.4",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.0.18"
  }
}
