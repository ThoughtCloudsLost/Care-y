{
  "name": "@care-y/root",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "typecheck": "tsc --build && pnpm --filter @care-y/client exec svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "format:fix": "prettier --write --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "tsc --build --clean",
    "migrate": "tsx --env-file=.env packages/server/src/db/migrate.ts up",
    "migrate:down": "tsx --env-file=.env packages/server/src/db/migrate.ts down"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "10.0.2",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-svelte": "3.15.0",
    "lefthook": "2.1.1",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.0.18"
  }
}
