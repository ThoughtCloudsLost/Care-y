{
  "name": "@care-y/root",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "typecheck": "pnpm --filter @care-y/shared run build:paraglide && pnpm --filter @care-y/client run build:paraglide && tsc --build && pnpm --filter @care-y/client exec svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint packages/",
    "lint:strict": "eslint packages/ --rule '@typescript-eslint/no-unused-vars: [error, { argsIgnorePattern: ^_, varsIgnorePattern: ^_, caughtErrorsIgnorePattern: ^_ }]'",
    "format": "prettier --check --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "format:fix": "prettier --write --ignore-path .prettierignore --ignore-path .prettierignore.local .",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server:db": "docker compose -f docker-compose.test.yml exec app pnpm vitest run --project server",
    "test:watch": "vitest",
    "test:coverage": "docker compose -f docker-compose.test.yml exec app pnpm vitest run --coverage && vitest run --project client --coverage",
    "test:up": "docker compose -f docker-compose.test.yml up -d --build",
    "test:down": "docker compose -f docker-compose.test.yml down",
    "test:down:clean": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "playwright test --project=chromium --project=onboarding-setup --project=onboarding --project=first-login",
    "test:e2e:seed": "docker compose exec -e SEED_ORG_SLUG=e2e-org app pnpm --filter @care-y/server exec tsx src/scripts/seed.ts",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:full": "curl -sf http://localhost:3000/health > /dev/null || (echo 'Docker API not running on port 3000. Start it with: pnpm dev:setup, pnpm dev, pnpm dev:mobile, or docker compose up -d' && exit 1) && vitest run --project client --coverage && pnpm test:e2e:coverage && pnpm coverage:merge",
    "clean": "tsc --build --clean",
    "migrate": "tsx --env-file=.env packages/server/src/db/migrate.ts --platform",
    "migrate:down": "tsx --env-file=.env packages/server/src/db/migrate.ts down --platform",
    "migrate:tenant": "tsx --env-file=.env packages/server/src/db/migrate.ts --schema=",
    "migrate:tenant:down": "tsx --env-file=.env packages/server/src/db/migrate.ts down --schema=",
    "migrate:all": "tsx --env-file=.env packages/server/src/db/migrate.ts --all-schemas",
    "migrate:create-schema": "tsx --env-file=.env packages/server/src/db/schema-create.ts",
    "seed": "docker compose exec app pnpm --filter @care-y/server exec tsx src/scripts/seed.ts",
    "dev:server": "tsx --env-file=.env packages/server/src/index.ts",
    "dev": "node scripts/dev-setup.mjs && pnpm --filter @care-y/client dev",
    "dev:mobile": "node scripts/dev-setup.mjs && pnpm --filter @care-y/client dev:mobile",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:db:clean": "docker compose down -v",
    "totp": "node scripts/totp.mjs",
    "postinstall": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sodium-native"
    ],
    "patchedDependencies": {
      "konsta": "patches/konsta.patch"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-svelte": "3.20.0",
    "fast-check": "4.8.0",
    "lefthook": "2.1.9",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "4.1.9"
  }
}
