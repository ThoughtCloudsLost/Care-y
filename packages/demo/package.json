{
  "name": "@care-y/demo",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/lib/index.ts",
    "./vite": "./vite.ts",
    "./app.css": "./src/app.css"
  },
  "scripts": {
    "dev": "pnpm --filter @care-y/client run build:paraglide && vite",
    "dev:mobile": "pnpm --filter @care-y/client run build:paraglide && node scripts/dev-network.js",
    "build": "pnpm --filter @care-y/client run build:paraglide && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "health": "pnpm --filter @care-y/client run build:paraglide && vite --open /health.html",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@care-y/crypto": "workspace:*",
    "@care-y/shared": "workspace:*",
    "@chenglou/pretext": "0.0.7",
    "@electric-sql/pglite": "0.5.4",
    "@lucide/svelte": "1.16.0",
    "@tanstack/svelte-query": "6.1.33",
    "@trpc/client": "11.10.0",
    "@trpc/server": "11.10.0",
    "buffer": "6.0.3",
    "konsta": "5.0.9",
    "kysely": "0.29.2",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "29.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
