{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src"
  },
  "watchOptions": {
    // Generated by paraglide (one module per message key, thousands of
    // files). Watching them pins one fd per file on macOS and can exhaust
    // the kernel file table; they only change via full recompiles anyway.
    "excludeDirectories": ["src/paraglide"]
  },
  "include": ["src"]
}
