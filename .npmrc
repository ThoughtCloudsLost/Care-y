# Pin exact versions - no ^ or ~ prefixes on install
# Defense-in-depth: lockfile handles determinism, but exact versions
# make package.json auditable without needing to parse ranges
save-exact=true

# Require all peer dependencies to be explicitly installed
# Prevents silent missing peers that break at runtime
strict-peer-dependencies=true

# Run package scripts through pnpm's POSIX-style shell emulator so the
# VAR=value prefixes in the root scripts (NODE_OPTIONS before tsc and
# svelte-check) work on Windows as well as macOS and Linux.
shell-emulator=true
