# ============================================================
# Database
# ============================================================
# Used by the app to connect to Postgres
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# Used by Docker Compose to initialize the Postgres container
POSTGRES_USER=care_y
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=care_y

# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-secret-here   # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_SECRET=                      # dev org TOTP secret for pnpm totp; set the real value in your local .env

# ============================================================
# Docker host port publishing (dev only)
# ============================================================
# Interface that Docker Compose publishes the app and Mailpit ports on.
# Defaults to loopback so nothing is reachable from the local network.
# Set it to a Tailscale or LAN address to test from a phone or simulator:
#   BIND_ADDR=$(tailscale ip -4)
# Warning: this also moves the Mailpit UI on 8025 off loopback. Mailpit has
# no authentication and lists every captured message, so unset BIND_ADDR
# again once device testing is done.
BIND_ADDR=127.0.0.1

# ============================================================
# Encryption
# ============================================================
OPS_SECRETS_KEY=your-ops-secrets-key-here   # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================
# tRPC
# ============================================================
CORS_ORIGIN=http://localhost:5173   # tRPC CORS origin

# ============================================================
# SMTP (optional, defaults to console logging if unset)
# ============================================================
SMTP_HOST=localhost          # Mailpit in dev, real SMTP in production
SMTP_PORT=1025               # Mailpit default; 587 for production SMTP
SMTP_FROM=noreply@care-y.app
SMTP_SECURE=false            # true for TLS (port 465), false for STARTTLS (port 587)
SMTP_USER=                   # SMTP auth username (optional in dev)
SMTP_PASSWORD=               # SMTP auth password (optional in dev)

# ============================================================
# OPRF (threshold split-key)
# ============================================================
# Generate with: pnpm --filter @care-y/server exec tsx src/scripts/generate-oprf-shares.ts
OPRF_SHARE_A_HEX=
OPRF_SHARE_B_HEX=
# Unix socket paths for OPRF process IPC (defaults work for Docker Compose)
OPRF_SOCKET_A=/run/oprf/oprf-a.sock
OPRF_SOCKET_B=/run/oprf/oprf-b.sock

# ============================================================
# Blob storage (encrypted file storage for attachments, recordings, etc.)
# ============================================================
BLOB_STORE_TYPE=local          # "local" = filesystem. Future: "s3"
BLOB_STORE_PATH=/app/data      # Absolute path inside container (volume-mounted)

# ============================================================
# Public intake form
# ============================================================
# Proof-of-work difficulty for intake submissions (leading zero bits in SHA-256).
# 0 or unset disables PoW. Typical values: 16 (light), 18-20 (moderate).
INTAKE_POW_DIFFICULTY=0

# ============================================================
# Trusted proxies
# ============================================================
# Comma-separated IP addresses of reverse proxies trusted to set X-Forwarded-For.
# When unset, only loopback peers (127.0.0.1, ::1, ::ffff:127.0.0.1) are trusted.
# In production, set to the Caddy reverse proxy's IP address.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
