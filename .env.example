# ============================================================
# Database
# ============================================================
# Used by the app to connect to Postgres
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# Used by Docker Compose to initialize the Postgres container
POSTGRES_USER=care_y
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=care_y

# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-secret-here   # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================
# Encryption
# ============================================================
OPS_SECRETS_KEY=your-ops-secrets-key-here   # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================
# tRPC
# ============================================================
CORS_ORIGIN=http://localhost:5173   # tRPC CORS origin

# ============================================================
# SMTP (optional, defaults to console logging if unset)
# ============================================================
SMTP_HOST=localhost          # Mailpit in dev, real SMTP in production
SMTP_PORT=1025               # Mailpit default; 587 for production SMTP
SMTP_FROM=noreply@care-y.app

# ============================================================
# OPRF (threshold split-key)
# ============================================================
# Generate with: pnpm --filter @care-y/server exec tsx src/scripts/generate-oprf-shares.ts
OPRF_SHARE_A_HEX=
OPRF_SHARE_B_HEX=
# Unix socket paths for OPRF process IPC (defaults work for Docker Compose)
OPRF_SOCKET_A=/run/oprf/oprf-a.sock
OPRF_SOCKET_B=/run/oprf/oprf-b.sock
